{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/builds/cmake-${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "APITOFSIM_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "clang-release",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "clang-profile",
      "inherits": "clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g"
      }
    }
  ]
}
